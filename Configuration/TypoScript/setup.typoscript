plugin {
  tx_contactbook {
    persistence {
      storagePid = {$plugin.tx_contactbook.persistence.storagePid}
    }

    view {
      partialRootPaths.10 = {$plugin.tx_psbtemplates.view.partialRootPath}
    }
  }

  tx_contactbook_contactgroups.view.defaultPid = auto
  tx_contactbook_contactlist.view.defaultPid = auto
}

module.tx_contactbook.persistence.storagePid = {$plugin.tx_contactbook.persistence.storagePid}
